# syntax=docker/dockerfile:1
# StickStage render as an AWS Lambda container image: one render per invocation (lambda/handler.ts).
#   pnpm lambda:build      (docker build --platform linux/amd64 --provenance=false -f Dockerfile.lambda -t stickstage-lambda .)
# amd64 only: Rhubarb has no arm64 release build. --provenance=false because Lambda rejects buildx's
# attestation manifest list. No account data in here: the bucket is the function's STICKSTAGE_BUCKET
# and AWS credentials come from its execution role.
ARG RHUBARB_VERSION=1.14.0

# Rhubarb: the release build, pinned by SHA-256 (same as Dockerfile).
FROM debian:bookworm-slim AS rhubarb
ARG RHUBARB_VERSION
RUN set -eux; \
    apt-get update; apt-get install -y --no-install-recommends ca-certificates curl unzip; rm -rf /var/lib/apt/lists/*; \
    curl -fsSL -o /tmp/rhubarb.zip "https://github.com/DanielSWolf/rhubarb-lip-sync/releases/download/v${RHUBARB_VERSION}/Rhubarb-Lip-Sync-${RHUBARB_VERSION}-Linux.zip"; \
    echo "a9a9074862cff47b2d59b8bf399a678a3b0b74f9452ad6ad94cb292913dd8667  /tmp/rhubarb.zip" | sha256sum -c -; \
    unzip -q /tmp/rhubarb.zip -d /opt; \
    mv "/opt/Rhubarb-Lip-Sync-${RHUBARB_VERSION}-Linux" /opt/rhubarb; \
    rm /tmp/rhubarb.zip; \
    chmod -R a+rX /opt/rhubarb

# The Lambda Runtime Interface Client is a native addon: build it apart so the compilers stay out of the image.
FROM node:22-bookworm-slim AS ric
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends g++ make cmake unzip libcurl4-openssl-dev autoconf automake libtool python3; \
    rm -rf /var/lib/apt/lists/*
WORKDIR /opt/ric
RUN npm init -y >/dev/null && npm install aws-lambda-ric@3 && chmod -R a+rX /opt/ric

FROM node:22-bookworm-slim

# Chrome Headless Shell's shared libraries and a fallback font (the skit font ships in public/fonts).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl fontconfig fonts-dejavu-core \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
      libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 libexpat1 libxcb1 libx11-6 libxext6; \
    rm -rf /var/lib/apt/lists/*

COPY --from=rhubarb /opt/rhubarb /opt/rhubarb
RUN /opt/rhubarb/rhubarb --version
COPY --from=ric /opt/ric /opt/ric

RUN npm install -g pnpm@11.17.0
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Kokoro is a dev-script dependency the render never uses (see Dockerfile). Lambda runs as an
# unprivileged user, so every layer makes its own files world-readable in the step that writes
# them: a chmod in a later layer would store a second copy of node_modules.
RUN pnpm install --frozen-lockfile \
 && rm -rf node_modules/kokoro-js node_modules/@huggingface node_modules/.pnpm/kokoro-js@* \
      node_modules/.pnpm/@huggingface+transformers@* node_modules/.pnpm/onnxruntime-* node_modules/.pnpm/phonemizer@* \
 && chmod -R a+rX node_modules
COPY . .
RUN node -e "if (typeof Intl.Segmenter !== 'function') process.exit(1); new Intl.Segmenter('ja', { granularity: 'word' })"
# Lambda's filesystem is read-only except /tmp, so job folders live there. Remotion launches Chrome
# through `setpriv --pdeathsig` whenever setpriv is on PATH, and Lambda's sandbox refuses setpriv's
# capability call ("keep process capabilities failed"), so Chrome never starts: remove it.
RUN node_modules/.bin/remotion browser ensure \
 && chmod -R a+rX node_modules/.remotion \
 && rm -rf public/skits/_jobs && ln -s /tmp/jobs public/skits/_jobs \
 && rm -f /usr/bin/setpriv
# The Remotion bundle, built once here instead of by webpack on every cold start (~20 s).
# It symlinks public/, so job folders written under /tmp/jobs at run time are still served.
RUN node_modules/.bin/tsx scripts/lambda-bundle.ts /app/build/bundle \
 && chmod -R a+rX /app/build

ENV NODE_ENV=production \
    RHUBARB_PATH=/opt/rhubarb/rhubarb \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    STICKSTAGE_BUNDLE_DIR=/app/build/bundle \
    NODE_OPTIONS=--import=tsx
ENTRYPOINT ["/opt/ric/node_modules/.bin/aws-lambda-ric"]
CMD ["lambda/index.handler"]
