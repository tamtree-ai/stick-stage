{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "spoken": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "type": "string",
            "minLength": 1
          },
          "durationMs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "startMs": {
                  "type": "number",
                  "minimum": 0
                },
                "endMs": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "text",
                "startMs"
              ]
            }
          }
        },
        "required": [
          "id",
          "text",
          "audio"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "lines"
  ],
  "$id": "https://stickstage.dev/schemas/voice.schema.json",
  "title": "StickStage voice"
}
