{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "kit": {
      "type": "string",
      "enum": [
        "plain",
        "interior",
        "office",
        "park",
        "street"
      ]
    },
    "palette": {
      "type": "string"
    },
    "groundY": {
      "type": "number",
      "minimum": 0
    },
    "figureHeightPx": {
      "default": 760,
      "type": "number",
      "minimum": 100
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": -0.5,
            "maximum": 1.5
          },
          "y": {
            "type": "number",
            "minimum": -0.5,
            "maximum": 1.5
          },
          "size": {
            "default": 1,
            "type": "number",
            "minimum": 0.2,
            "maximum": 4
          },
          "seed": {
            "type": [
              "string",
              "number"
            ]
          },
          "pattern": {
            "type": "string",
            "enum": [
              "none",
              "halftone",
              "stripes",
              "dots"
            ]
          },
          "flip": {
            "default": false,
            "type": "boolean"
          },
          "mark": {
            "type": "string"
          },
          "dx": {
            "default": 0,
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "variant": {
            "type": "string"
          },
          "seatFor": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "part"
        ]
      }
    },
    "foreground": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": -0.5,
            "maximum": 1.5
          },
          "y": {
            "type": "number",
            "minimum": -0.5,
            "maximum": 1.5
          },
          "size": {
            "default": 1,
            "type": "number",
            "minimum": 0.2,
            "maximum": 4
          },
          "seed": {
            "type": [
              "string",
              "number"
            ]
          },
          "pattern": {
            "type": "string",
            "enum": [
              "none",
              "halftone",
              "stripes",
              "dots"
            ]
          },
          "flip": {
            "default": false,
            "type": "boolean"
          },
          "mark": {
            "type": "string"
          },
          "dx": {
            "default": 0,
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "variant": {
            "type": "string"
          },
          "seatFor": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "part"
        ]
      }
    },
    "marks": {
      "default": {
        "left": 0.3,
        "center": 0.5,
        "right": 0.7
      },
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kit",
    "palette",
    "groundY",
    "layers"
  ],
  "$id": "https://stickstage.dev/schemas/set.schema.json",
  "title": "StickStage set"
}
