{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "template": {
      "type": "string",
      "enum": [
        "exchange",
        "interview",
        "me-vs-me",
        "pov-monologue",
        "text-slam"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string"
    },
    "pov": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "hashtags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "set": {
      "type": "string"
    },
    "cast": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "character": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "holding": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "character"
        ],
        "additionalProperties": false
      }
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "setup",
              "escalation",
              "punchline"
            ]
          },
          "expression": {
            "type": "string"
          },
          "slam": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "delivery": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "template",
    "title",
    "cast",
    "lines"
  ],
  "additionalProperties": false,
  "$id": "https://stickstage.dev/schemas/premise.schema.json",
  "title": "StickStage premise"
}
