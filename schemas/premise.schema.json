{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "template": {
      "type": "string",
      "enum": [
        "exchange",
        "interview",
        "me-vs-me",
        "pov-monologue",
        "text-slam",
        "explainer",
        "family",
        "fable",
        "trio"
      ]
    },
    "aspect": {
      "default": "9:16",
      "type": "string",
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string"
    },
    "pov": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "hashtags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "set": {
      "type": "string"
    },
    "cast": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "character": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "holding": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "character"
        ],
        "additionalProperties": false
      }
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "setup",
              "escalation",
              "punchline"
            ]
          },
          "expression": {
            "type": "string"
          },
          "slam": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "delivery": {
            "type": "string"
          },
          "voiceOver": {
            "type": "boolean"
          },
          "gag": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "set": {
            "type": "string"
          },
          "pov": {
            "type": "string",
            "maxLength": 80
          },
          "card": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "who": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "setup",
                    "escalation",
                    "punchline"
                  ]
                },
                "expression": {
                  "type": "string"
                },
                "slam": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "delivery": {
                  "type": "string"
                },
                "voiceOver": {
                  "type": "boolean"
                },
                "gag": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "lines"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "template",
    "title",
    "cast"
  ],
  "additionalProperties": false,
  "$id": "https://stickstage.dev/schemas/premise.schema.json",
  "title": "StickStage premise"
}
