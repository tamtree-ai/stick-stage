{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "default": 1,
          "type": "number",
          "minimum": 0.3,
          "maximum": 3
        },
        "colors": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{3,8}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{3,8}$"
            },
            "screen": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{3,8}$"
            }
          },
          "required": [
            "body"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "forearm",
            "upright"
          ]
        },
        "angle": {
          "default": 0,
          "type": "number"
        },
        "text": {
          "type": "string",
          "maxLength": 24
        },
        "screen": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aliases": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rank": {
          "default": 1000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "phone",
            "mic",
            "cup",
            "laptop",
            "sign"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "colors",
        "align",
        "kind"
      ]
    },
    {
      "type": "object",
