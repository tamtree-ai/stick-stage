      "role": "escalation",
      "prop": "laptop"
    },
    {
      "who": "june",
      "text": "He never liked Biscuit.",
      "expression": "deadpan",
      "role": "escalation"
    },
    {
      "who": "milo",
      "text": "Clause forty-seven: they get your firstborn child!",
      "expression": "shocked",
      "role": "escalation",
      "gag": "double-take"
