    {
      "who": "june",
      "text": "Only on weekends. Read the fine print.",
      "expression": "deadpan",
      "role": "escalation"
    },
    {
      "who": "milo",
      "text": "Wait. How do you know the fine print without reading it?",
      "expression": "confused",
      "role": "escalation"
    },
    {
      "who": "june",
      "text": "I wrote it.",
      "expression": "smug",
      "role": "punchline",
